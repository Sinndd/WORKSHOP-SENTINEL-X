# --- Secrets : JAMAIS dans Git ---
.env
mosquitto/secrets/*
!mosquitto/secrets/.gitkeep
mosquitto/certs/*
!mosquitto/certs/.gitkeep
*.key
*.pem

# --- Données / sauvegardes ---
backups/
*.dump
*.sqlite
*.db

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Divers ---
.DS_Store
*.swp

# --- Firmware : secrets de l'appareil ---
secrets.h
!secrets.h.example

# --- Modèle 3D (Wall-E © Disney/Pixar : non diffusé dans le dépôt) ---
# Source FBX à la racine ; le GLB est régénéré par : cd dashboard && npm run model
*.fbx
dashboard/public/models/*.glb

# --- Paquet hors ligne (scripts/bundle-offline.sh) ---
sentinel-offline-*.tar.gz
sentinel-offline-*.tar.gz.sha256

# Local AI/YOLO files
.venv-yolo/
data/
yolov8n.pt
