# --- Secrets : JAMAIS dans Git ---
.env
mosquitto/secrets/*
!mosquitto/secrets/.gitkeep
mosquitto/certs/*
!mosquitto/certs/.gitkeep
*.key
*.pem

# --- Données / sauvegardes ---
backups/
*.dump
*.sqlite
*.db

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Divers ---
.DS_Store
*.swp

# --- Firmware : secrets de l'appareil ---
secrets.h
!secrets.h.example

# --- Paquet hors ligne (scripts/bundle-offline.sh) ---
sentinel-offline-*.tar.gz
sentinel-offline-*.tar.gz.sha256
