# ACL Mosquitto — SENTINEL-X (contrat v2, nœud ESP32 unique). Tout le reste est refusé.
# (En MQTT 3.1.1, une publication refusée est ignorée silencieusement.)

# Module ESP32 SENTINEL-X-CORE
user esp32
topic write sentinel/telemetry
topic write sentinel/alerts
topic write sentinel/access
topic write sentinel/enroll
topic read  sentinel/commands
topic read  sentinel/access/response

# Ingestion MQTT -> PostgreSQL
user ingestor
topic read sentinel/telemetry
topic read sentinel/alerts
topic read sentinel/vision/events

# API : lecture globale, décisions d'accès RFID et commandes superviseur
user api
topic read  sentinel/#
topic write sentinel/commands
topic write sentinel/access/response

# Script IA caméra (sur l'hôte)
user vision
topic write sentinel/vision/events

# Healthcheck Docker du broker : uniquement l'uptime.
user healthcheck
topic read $SYS/broker/uptime
