// Copier en secrets.h (ignoré par Git) et remplir. Valeurs MQTT_PASS_ESP32 et API_DEVICE_TOKEN : fichier .env du serveur.
// Ne jamais committer secrets.h : il contient le mot de passe Wi-Fi et les identifiants de l'appareil.
#pragma once
#define WIFI_SSID         "nom-du-wifi"
#define WIFI_PASS         "mot-de-passe-wifi-wpa2-long-et-unique"
#define MQTT_PASS         "valeur de MQTT_PASS_ESP32"
#define API_DEVICE_TOKEN  "valeur de API_DEVICE_TOKEN"
// Clé maîtresse des badges (32 caractères hexadécimaux = 16 octets) : openssl rand -hex 16 ; la perdre rend les badges inutilisables.
#define CARD_MASTER_KEY   "00000000000000000000000000000000"
