# Copie de référence : NE PAS remplir à la main.
# Le vrai fichier .env (gitignoré) est généré par : ./scripts/gen-env.sh

TZ=Europe/Paris

# UID/GID de l'utilisateur hôte : Mosquitto tourne sous cette identité
# (il lit passwd/acl/clé TLS en 0600 sans chown vers 1883).
PUID=1000
PGID=1000

# Nom d'hôte ajouté au SAN du certificat serveur (en plus de 192.168.10.1 et sentinel.local)
SENTINEL_HOSTNAME=sentinel
# IP supplémentaires du certificat MQTT (séparées par des espaces), ex. poste de dev : "10.69.127.207"
SENTINEL_EXTRA_IPS=

# Adresses/ports publiés (filtrés en plus par UFW + chaîne DOCKER-USER)
MQTT_BIND_ADDR=0.0.0.0
MQTT_PORT=8883
PROXY_BIND_ADDR=0.0.0.0
HTTPS_PORT=443                          # proxy HTTPS (Caddy) : seul point d'entrée web ; 80 redirige vers 443
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_PASSWORD=change-me            # superuser : init + sauvegardes uniquement
SENTINEL_APP_PASSWORD=change-me        # rôle sentinel_app (API + ingestor)
SENTINEL_RO_PASSWORD=change-me         # rôle sentinel_ro  (IA + dashboard)

# MQTT (hachés dans mosquitto/secrets/passwd par mosquitto_passwd)
MQTT_PASS_ESP32=change-me
MQTT_PASS_INGESTOR=change-me
MQTT_PASS_API=change-me
MQTT_PASS_VISION=change-me
MQTT_PASS_HEALTHCHECK=change-me

# API (Authorization: Bearer <jeton>)
API_TOKEN=change-me                    # dashboard / opérateur : lecture, commandes, badges
API_DEVICE_TOKEN=change-me             # ESP32 : POST /api/v1/alerts uniquement

# Dashboard Web (Connexion utilisateur / mot de passe)
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me             # mot de passe TEMPORAIRE du 1er administrateur (à changer à la 1re connexion)

# Vision (machine qui exécute scripts/run-vision.sh) : alerte quand une personne inconnue est détectée
DISCORD_WEBHOOK_URL=                   # webhook Discord du salon d'alertes (SECRET) ; vide = pas de notification
UNKNOWN_ALARM=on                       # alarme du robot (buzzer + LED rouge) ; off pour la couper
UNKNOWN_ALARM_SECONDS=10
UNKNOWN_COOLDOWN_S=15                  # une alerte toutes les 15 s au plus tant que l'inconnu reste
DISCORD_SEND_IMAGE=on                  # joindre l'image de la caméra au message (donnée personnelle envoyée à Discord)
