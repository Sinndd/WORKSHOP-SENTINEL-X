{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sentinel-x:schema:ai-event:v1",
  "title": "SENTINEL-X AI Event",
  "type": "object",
  "required": ["event_id", "timestamp", "type", "zone", "severity", "details"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": {
      "type": "string",
      "enum": [
        "human_presence_detected",
        "intrusion_detected",
        "gas_spike",
        "temperature_above_threshold",
        "motion_anomaly",
        "ml_anomaly_detected"
      ]
    },
    "zone": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": { "type": "string" },
    "sensor": { "type": "string" },
    "value": { "type": "number" },
    "threshold": { "type": "number" },
    "model": { "type": "string" },
    "details": { "type": "object" }
  },
  "additionalProperties": true
}
